{
  "manifest_version": 3,
  "name": "Okolos",
  "version": "0.0.1",
  "description": "Finds instructions hidden on a page for your AI assistant, and shows you everything it sends.",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Okolos"
  },
  "options_page": "options.html",
  "permissions": ["storage", "alarms", "activeTab"],
  "icons": {},
  "minimum_chrome_version": "116"
}
