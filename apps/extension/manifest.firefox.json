{
  "manifest_version": 3,
  "name": "Okolos",
  "version": "0.0.1",
  "description": "Finds instructions hidden on a page for your AI assistant, and shows you everything it sends.",
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Okolos",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "declarativeNetRequest",
    "webNavigation",
    "downloads",
    "management"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "okolos@ssheleg.dev",
      "strict_min_version": "128.0"
    }
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "interstitial.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
