{
  "name": "okolos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Browser security for the age of AI agents \u2014 local-first, verifiable.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssheleg/okolos.git"
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "pnpm build && pnpm build:e2e && playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "ux:lint": "python3 docs/ux/lint.py",
    "gates": "pnpm lint && pnpm typecheck && pnpm build && pnpm test && pnpm ux:lint",
    "build:e2e": "node tools/build.mjs --with-test-hooks",
    "test:e2e:firefox": "pnpm build && node tools/firefox-e2e.mjs",
    "wireframes": "node tools/wireframes.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.57.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^22.18.0",
    "@types/selenium-webdriver": "^4.35.6",
    "axe-core": "^4.12.1",
    "eslint": "^9.39.0",
    "fake-indexeddb": "^6.2.2",
    "fast-check": "^4.3.0",
    "geckodriver": "^6.1.1",
    "happy-dom": "^20.0.0",
    "prettier": "^3.6.2",
    "selenium-webdriver": "^4.46.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
