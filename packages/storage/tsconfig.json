{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // IndexedDB lives in the DOM lib; storage is the one package that talks to it.
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts"],
  // Tests are not part of a built package, and shipping them puts their
  // fixtures — including deliberate examples of the very calls the bundle
  // gates forbid — inside the artefact those gates read.
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../contracts" }]
}
