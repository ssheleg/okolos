{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts"],
  // Tests are not part of a built package, and shipping them puts their
  // fixtures — including deliberate examples of the very calls the bundle
  // gates forbid — inside the artefact those gates read.
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "../i18n" }, { "path": "../contracts" },
    { "path": "../core-queue" },
    { "path": "../core-leaks" },
    { "path": "../core-recovery" },
    { "path": "../core-extensions" },
    { "path": "../core-feeds" }]
}
